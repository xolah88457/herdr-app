#!/bin/bash
# Assemble Herdr.app (binary, icon, Info.plist) from target/release/herdr-app.
# Shared by scripts/install-macos and the mac-dmg workflow; signing is the caller's.
#   mac-bundle <dest.app>
# Environment:
#   HERDR_BUNDLE_VERSION  CFBundleShortVersionString (default 0.0.1)
#   HERDR_BUNDLE_PATH     PATH for Finder launches (LSEnvironment); unset adds none
set -euo pipefail

app=${1:?usage: mac-bundle dest.app}
[[ $(uname -s) == Darwin ]] || { echo 'mac-bundle requires macOS.' >&2; exit 1; }
cd "$(dirname "$0")/.."
version=${HERDR_BUNDLE_VERSION:-0.0.1}

mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
# Replace atomically so installing does not interrupt a running Herdr.
cp target/release/herdr-app "$app/Contents/MacOS/Herdr.new"
mv -f "$app/Contents/MacOS/Herdr.new" "$app/Contents/MacOS/Herdr"
chmod +x "$app/Contents/MacOS/Herdr"
cp assets/icons/Herdr.icns "$app/Contents/Resources/Herdr.icns"

cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleExecutable</key><string>Herdr</string>
    <key>CFBundleIdentifier</key><string>dev.herdr.app</string>
    <key>CFBundleName</key><string>Herdr</string>
    <key>CFBundleDisplayName</key><string>Herdr</string>
    <key>CFBundleIconFile</key><string>Herdr</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$version</string>
    <key>CFBundleVersion</key><string>1</string>
    <key>NSMicrophoneUsageDescription</key><string>Terminal programs running in Herdr can use the microphone, for example for voice input.</string>
    <key>NSCameraUsageDescription</key><string>Terminal programs running in Herdr can use the camera.</string>
    <key>NSAppleEventsUsageDescription</key><string>Terminal programs running in Herdr can use AppleScript to control other apps.</string>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>LSEnvironment</key><dict/></dict></plist>
PLIST
# Finder does not inherit a login shell's PATH; local installs bake theirs in.
if [[ -n ${HERDR_BUNDLE_PATH:-} ]]; then
  /usr/libexec/PlistBuddy -c "Add :LSEnvironment:PATH string $HERDR_BUNDLE_PATH" "$app/Contents/Info.plist"
fi
